"use strict";

/* Website Settings */

const WEBSITE_CONFIG = {
  title: "My Forever Person",
  visitor: "Pari",
  creator: "Her Forever Bandar 🐒",
  secretWord: "BANDARIYA",
  loadingDuration: 2500,
  musicStartsAutomatically: false
};

/* DOM Selection Helpers */

const $ = (selector, parent = document) =>
  parent.querySelector(selector);

const $$ = (selector, parent = document) =>
  [...parent.querySelectorAll(selector)];

/* Accessibility Settings */

const prefersReducedMotion = window.matchMedia(
  "(prefers-reduced-motion: reduce)"
).matches;

/* Delay Helper */

const wait = (milliseconds) =>
  new Promise(resolve => setTimeout(resolve, milliseconds));

/* Safe Text Helper */

function setText(element, text) {
  if (element) {
    element.textContent = text;
  }
}

/* Animation Helper */

function animateElement(element, animationName, duration = 700) {
  if (!element || prefersReducedMotion) return;

  element.style.animation = "none";

  requestAnimationFrame(() => {
    element.style.animation =
      `${animationName} ${duration}ms ease both`;
  });
}

/* Loading Screen Controller */

async function startLoadingScreen() {
  const loadingScreen = $("#loading-screen");

  if (!loadingScreen) return;

  await wait(WEBSITE_CONFIG.loadingDuration);

  loadingScreen.style.opacity = "0";
  loadingScreen.style.visibility = "hidden";

  loadingScreen.setAttribute("aria-hidden", "true");
}

/* Website Foundation */

const PariUniverse = {
  config: WEBSITE_CONFIG,
  select: $,
  selectAll: $$,
  wait,
  setText,
  animateElement,
  startLoadingScreen,
  prefersReducedMotion
};

/* Make Foundation Available */

window.PariUniverse = PariUniverse;

/* Start Website */

document.addEventListener("DOMContentLoaded", () => {
  document.documentElement.classList.add("app-ready");

  startLoadingScreen();
});
